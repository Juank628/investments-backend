# Postgres connection string (Railway "Public Network" URL or local instance)
DATABASE_PUBLIC_URL="postgres://user:password@host:port/database"

# Secret used to sign/verify JWTs — use a long random string
JWT_PRIVATE_KEY="long random string"

# Origin allowed to send credentialed requests (your frontend's URL)
CORS_ORIGIN="http://localhost:5173"

# development | production — controls cookie Secure/SameSite behavior
NODE_ENV="development"

# Used only by `npm run seed` to create the first admin user
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="pass6898781"
